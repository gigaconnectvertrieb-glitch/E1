# Lokaler Start
PORT=8787
HOST=127.0.0.1

# Admin-Token (min. 16 Zeichen). Ohne Wert wird data/admin-token.txt erzeugt.
E1_ADMIN_TOKEN=change-me-min-16-zeichen

# Optional: Postgres statt SQLite (auf Render empfohlen, weil die Free-Disk ephemer ist)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=false

# Optional: Webhook bei neuem Lead (n8n, Zapier, Make, eigener Endpoint)
# E1_LEAD_WEBHOOK=https://example.com/hooks/e1-lead

# TeamGermany Vertriebsportal (nur Env, nie ins Repo)
TG_PORTAL_URL=https://vertriebspartner.teamgermany.de
TG_PORTAL_USER=
TG_PORTAL_PASS=
TG_TARIFF_PATH=/tarifrechner/

# Telegram-Bot fuer den MFA-Code
TG_BOT_TOKEN=
TG_CHAT_ID=
